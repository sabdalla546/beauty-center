{
  "name": "beauty-center-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Beauty Center POS & Management System using Node.js, Express, TypeScript, Sequelize, MySQL.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsc && nodemon --exec \"ts-node --files\" src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:permissions": "ts-node --files src/seed/seed-permissions.ts",
    "fix:users-indexes": "ts-node --files src/scripts/cleanup-users-indexes.ts",
    "test": "jest"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "i18next": "^25.6.3",
    "i18next-fs-backend": "^2.6.1",
    "i18next-http-middleware": "^3.8.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "path": "^0.12.7",
    "pdfkit": "^0.17.2",
    "puppeteer": "^24.38.0",
    "sequelize": "^6.37.7",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.13"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "clearMocks": true,
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.test.json"
      }
    }
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/i18next": "^13.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/pdfkit": "^0.17.4",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
